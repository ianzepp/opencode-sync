{
  "name": "opencode-sync",
  "version": "1.0.0",
  "description": "Sync OpenCode conversations between machines",
  "main": "dist/cli.js",
  "bin": {
    "opencode-sync": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc && node -e \"require('fs').rmSync('dist/web/public',{recursive:true,force:true}); require('fs').cpSync('src/web/public','dist/web/public',{recursive:true})\"",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build",
    "start": "node dist/cli.js",
    "test": "echo \"No tests specified\" && exit 0"
  },
  "keywords": [
    "opencode",
    "sync",
    "conversations",
    "backup"
  ],
  "author": "Ian Zepp <ian.zepp@protonmail.com>",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "chalk": "^5.3.0",
    "commander": "^11.1.0",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^20.8.0",
    "typescript": "^5.2.2"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "preferGlobal": true
}
